@use "../base/variables" as *;
@use "../base/mixins" as *;

.material-update-dialog {
    &__content {
        max-height: 95vh;
        overflow-y: auto;

        @include respond-to(lg) {
            max-width: 56rem;
        }
    }

    &__form {
        >*+* {
            margin-top: $space-4;
        }
    }

    &__overview {
        display: grid;
        gap: $space-3;
        padding: $space-4;
        border: 1px solid $color-divider;
        border-radius: $radius-2xl;
        background: hsl-alpha($surface-h, 0.6);
    }

    &__overview-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: $space-3;
    }

    &__overview-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
    }

    &__overview-subtitle {
        margin: $space-1 0 0;
        color: $color-muted;
        font-size: 0.82rem;
    }

    &__overview-pill {
        display: inline-flex;
        align-items: center;
        border-radius: $radius-full;
        padding: $space-1 $space-2;
        font-size: 0.72rem;
        font-weight: 600;
        color: $color-primary;
        background: hsl-alpha($accent-h, 0.12);
        white-space: nowrap;
    }

    &__detail-grid {
        display: grid;
        gap: $space-3;
        grid-template-columns: 1fr;

        @include respond-to(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    &__detail-card {
        display: flex;
        flex-direction: column;
        gap: $space-2;
        padding: $space-3;
        border: 1px solid hsl-alpha($border-h, 0.4);
        border-radius: $radius-xl;
        background: hsl-alpha($surface-h, 0.72);
    }

    &__detail-card-head {
        display: flex;
        align-items: center;
        gap: $space-2;
    }

    &__detail-icon {
        width: 0.95rem;
        height: 0.95rem;
        color: $color-primary;
    }

    &__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: $space-3;

        @include respond-to(lg) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    &__field {
        >*+* {
            margin-top: $space-2;
        }

        &--full {
            grid-column: 1 / -1;
        }
    }

    &__input--error,
    &__textarea--error {
        border-color: $color-destructive;
    }

    &__error {
        color: $color-destructive;
        font-size: 0.85rem;
        margin-top: $space-1;
    }

    &__detail-label {
        font-weight: 600;
        color: $color-muted;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    &__detail-value {
        color: $color-heading;
        font-variant-numeric: tabular-nums;
        font-size: 0.95rem;
        font-weight: 600;
    }

    &__history {
        background: $color-surface;
        border-radius: $radius-2xl;
        padding: $space-4;
    }

    &__history-heading {
        margin-bottom: $space-3;
    }

    &__section-title {
        margin: 0 0 $space-1;
        font-size: 1rem;
    }

    &__history-caption {
        margin: 0;
        color: $color-muted;
        font-size: 0.85rem;
    }

    &__history-empty {
        color: $color-muted;
    }

    &__table-wrap {
        overflow-x: auto;
        border: 1px solid $color-divider;
        border-radius: $radius-xl;
    }

    &__history-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 58rem;
        font-size: 0.8rem;
        table-layout: fixed;

        thead th {
            position: sticky;
            top: 0;
            z-index: 1;
            text-align: left;
            padding: $space-2 $space-2_5;
            background: $color-surface;
            color: $color-muted;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            border-bottom: 1px solid $color-divider;
        }

        tbody td {
            padding: $space-2_5 $space-2_5;
            border-top: 1px solid $color-divider;
            vertical-align: middle;
            line-height: 1.35;
            white-space: nowrap;
        }

        tbody tr {
            transition: background-color $transition-fast;
        }

        tbody tr:nth-of-type(even) {
            background: hsl-alpha($divider-h, 0.24);
        }

        tbody tr:hover {
            background: hsl-alpha($accent-h, 0.1);
        }
    }

    &__numeric {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    &__quantity {
        font-weight: 600;

        &--positive {
            color: $color-success;
        }

        &--negative {
            color: $color-destructive;
        }
    }

    &__transaction-pill {
        display: inline-flex;
        align-items: center;
        gap: $space-1;
        padding: $space-1 $space-2;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;

        &--purchase {
            color: $color-success;
            background: hsl-alpha($success-h, 0.12);
            border: 1px solid hsl-alpha($success-h, 0.2);
        }

        &--consumption {
            color: $color-destructive;
            background: hsl-alpha($destructive-h, 0.12);
            border: 1px solid hsl-alpha($destructive-h, 0.2);
        }
    }

    &__actions {
        display: flex;
        justify-content: flex-end;
        gap: $space-3;
    }
}
